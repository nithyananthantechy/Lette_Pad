# ============================================================
# AI Letter Pad Platform — Environment Variables Example
# ============================================================

PORT=5000
NODE_ENV=production

# PostgreSQL (Neon Cloud Connection String or Local)
DATABASE_URL=postgresql://username:password@host/database?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=letterpad_db
DB_USER=postgres
DB_PASSWORD=your_db_password

# JWT Secrets (Random 32-character strings)
JWT_SECRET=your_super_secret_jwt_key_32_characters_long_here
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Gmail SMTP for OTP Delivery
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend URL for CORS
FRONTEND_URL=https://letterpad.nskgroups.website
